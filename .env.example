# =============================================================================
# Redesign Service - Development Environment Configuration
# =============================================================================
# Copy to .env and adjust values as needed

# Application
ENVIRONMENT=development
APP_NAME=Redesign Service
APP_VERSION=0.1.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5456/redesign_service  # pragma: allowlist secret
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6396/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_DECODE_RESPONSES=true

# API Settings
API_HOST=0.0.0.0
API_PORT=6306
API_DEBUG=true
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Authentication
AUTH_ENABLED=false
DEFAULT_TENANT_ID=n8n-dev

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_JSON_LOGS=false

# =============================================================================
# Docker Overrides (when running inside docker-compose)
# =============================================================================
# DATABASE_URL=postgresql+psycopg://postgres:changeme@redesign_service_postgres:5432/redesign_service  # pragma: allowlist secret
# REDIS_URL=redis://redesign-service-redis:6379/0
# STORAGE_LOCAL_PATH=/app/data
